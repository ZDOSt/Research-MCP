# Private Search Gateway
# Copy this file to .env before the first start.

# Pinned images and local build names.
PYTHON_IMAGE=python:3.11.15-slim-bookworm
SEARCH_GATEWAY_IMAGE=private-search-gateway:local
REDIS_IMAGE=redis:7.4.9-alpine3.21
SEARXNG_IMAGE=searxng/searxng:2026.7.11-62a1ab7ed
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9.3
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.1
CRAWL4AI_DERIVED_IMAGE=private-search-crawl4ai:local

# Numeric identity used by the gateway containers and writable tmpfs mounts.
APP_UID=10001
APP_GID=10001

# Shared Docker network used by AnythingLLM, LibreChat, OpenWebUI, or another
# frontend. It must already exist. No host ports are published by this stack.
CLIENT_DOCKER_NETWORK=docker-stacks_app-network

# Generate different random values for all three secrets:
#   openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-32-byte-hex-value
CRAWL4AI_API_TOKEN=replace-with-a-different-random-32-byte-hex-value
# Credential supplied by LibreChat, Open WebUI, or LobeChat when they use the
# Firecrawl-compatible scraper. Generate a third distinct random value.
FIRECRAWL_API_KEY=replace-with-a-third-random-32-byte-hex-value

# Gateway behavior. Auto mode chooses quick or balanced work from the query;
# clients may explicitly request quick, balanced, or deep.
GATEWAY_REQUEST_TIMEOUT_SECONDS=30
GATEWAY_SEARCH_TIMEOUT_SECONDS=7
GATEWAY_PAGE_TIMEOUT_SECONDS=16
GATEWAY_MAX_SEARCH_RESULTS=30
GATEWAY_MAX_CRAWL_PAGES=6
GATEWAY_MAX_FOLLOW_LINKS=2
GATEWAY_MAX_CONCURRENT_FETCHES=4
# Bound distinct requests so bursts cannot exhaust the VPS. Excess requests
# wait briefly, then receive HTTP 503 with Retry-After rather than overloading it.
GATEWAY_MAX_CONCURRENT_REQUESTS=4
GATEWAY_ADMISSION_TIMEOUT_SECONDS=2
# Reserve time after page retrieval for passage selection and result assembly.
GATEWAY_FINALIZATION_RESERVE_SECONDS=3
GATEWAY_CANDIDATE_RERANKER_TIMEOUT_SECONDS=2
GATEWAY_INTEGRATED_TIMEOUT_SECONDS=20
GATEWAY_INTEGRATED_MAX_SEARCH_RESULTS=16
GATEWAY_INTEGRATED_MAX_CRAWL_PAGES=3
GATEWAY_INTEGRATED_MAX_RESULTS=5
GATEWAY_MAX_FINAL_RESULTS=8
GATEWAY_MAX_PASSAGE_CHARS=2600
GATEWAY_MAX_CONTENT_CHARS=7000
GATEWAY_QUERY_MAX_CHARS=4000
GATEWAY_MAX_REQUEST_BYTES=65536

# Fresh results are returned immediately. Stale cached results are used only if
# a refresh fails, so temporary provider failures do not produce empty answers.
GATEWAY_CACHE_TTL_SECONDS=900
GATEWAY_CACHE_STALE_SECONDS=86400
GATEWAY_CACHE_MAX_ENTRIES=256

# Local reranker. The gateway degrades to lexical ranking if it is unavailable.
RERANKER_MODEL=BAAI/bge-reranker-base
GATEWAY_RERANKER_TIMEOUT_SECONDS=5
GATEWAY_RERANKER_MAX_RESPONSE_BYTES=2097152

# Firecrawl v2-compatible routes. The scrape route uses the same protected
# direct/Crawl4AI/Playwright fetch pipeline as integrated search.
FIRECRAWL_TIMEOUT_SECONDS=20
FIRECRAWL_MAX_TIMEOUT_SECONDS=45
FIRECRAWL_MAX_CONTENT_CHARS=300000
FIRECRAWL_MAX_RESPONSE_BYTES=4194304
FIRECRAWL_MAX_RESULTS=20

# Page retrieval. Direct HTTP is tried first. Crawl4AI and Playwright are used
# only for the highest-ranked pages that need JavaScript or deeper interaction.
GATEWAY_DIRECT_TIMEOUT_SECONDS=5
GATEWAY_DIRECT_MAX_BYTES=8388608
GATEWAY_PAGE_MAX_CHARS=300000
CRAWL4AI_TOTAL_TIMEOUT_SECONDS=30
CRAWL4AI_MAX_RESPONSE_BYTES=8388608
CRAWL4AI_EGRESS_CONNECT_TIMEOUT_SECONDS=15
RESEARCH_BROWSER_TOTAL_TIMEOUT_SECONDS=30
RESEARCH_BROWSER_SANDBOX_MODE=auto
WEB_RUNNER_MAX_REQUEST_BYTES=2097152
WEB_RUNNER_MAX_RESPONSE_BYTES=8388608

# PDF parsing limits. PDF parsing runs in a network-isolated container.
GATEWAY_PDF_MAX_PAGES=100
PDF_TIMEOUT_SECONDS=20
PDF_SANDBOX_MEMORY_BYTES=536870912
PDF_SANDBOX_CPU_SECONDS=15
PDF_SANDBOX_OUTPUT_BYTES=6065536

# Public-web egress policy. Private, loopback, link-local, and metadata
# destinations are denied by code in addition to this optional extra deny list.
SAFE_EGRESS_ALLOWED_PORTS=80,443,8080,8443
SAFE_EGRESS_DENY_CIDRS=
SAFE_EGRESS_DNS_TIMEOUT_SECONDS=5
SAFE_EGRESS_CONNECT_TIMEOUT_SECONDS=15
SAFE_EGRESS_HANDSHAKE_TIMEOUT_SECONDS=5
SAFE_EGRESS_IDLE_TIMEOUT_SECONDS=45
SAFE_EGRESS_MAX_CONNECTION_SECONDS=120
SAFE_EGRESS_MAX_CONNECTIONS=128
SAFE_EGRESS_QUEUE_TIMEOUT_SECONDS=1
SAFE_EGRESS_MAX_BYTES_PER_DIRECTION=67108864

# Resource ceilings tuned for a 16 GB VPS. They are limits, not reservations.
GATEWAY_CPUS=1.5
GATEWAY_MEMORY_LIMIT=1g
REDIS_CPUS=0.5
REDIS_MEMORY_LIMIT=384m
REDIS_MAXMEMORY=256mb
SEARXNG_CPUS=1.0
SEARXNG_MEMORY_LIMIT=768m
SEARXNG_WORKERS=2
SEARXNG_THREADS=4
RERANKER_CPUS=2.0
RERANKER_MEMORY_LIMIT=3g
CRAWL4AI_CPUS=2.0
CRAWL4AI_MEMORY_LIMIT=2560m
CRAWL4AI_SHM_SIZE=1gb
SAFE_EGRESS_CPUS=0.5
SAFE_EGRESS_MEMORY_LIMIT=256m
WEB_RUNNER_CPUS=2.0
WEB_RUNNER_MEMORY_LIMIT=2g
WEB_RUNNER_SHM_SIZE=1gb
PDF_RUNNER_CPUS=1.0
PDF_RUNNER_MEMORY_LIMIT=512m

LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
